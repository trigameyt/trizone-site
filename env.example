# ============================================================
# TRIZONE SITE v3.4.0 - MYSQL / MARIADB
# Mets les vraies valeurs uniquement dans Render > Environment.
# Ne publie jamais les secrets dans GitHub.
# ============================================================

BASE_URL=https://trizone.club
PORT=3000
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://trizone.club/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_DEFAULT_PLUS_ID=
DISCORD_ROLE_VIP_ID=
DISCORD_ROLE_VIP_PLUS_ID=
DISCORD_ROLE_HERO_ID=
DISCORD_ROLE_EMPEROR_ID=
DISCORD_ROLE_IMPERATOR_ID=
ADMIN_DISCORD_IDS=YOUR_DISCORD_ID

# ===================== MYSQL / MARIADB =====================
# Option A (recommandée): URL unique
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/trizone

# Option B: champs séparés. Laisse MYSQL_URL vide si tu utilises cette méthode.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=trizone
MYSQL_POOL_SIZE=8

# La plupart des bases MySQL d'hébergeurs Minecraft internes n'utilisent pas TLS.
# Active-le seulement si ton hébergeur te le demande.
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL_CA=
MYSQL_SSL_CA_PATH=

# Stripe Managed Payments
STRIPE_API_VERSION=2025-03-31.basil
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEFAULT_PLUS_ID=
STRIPE_PRICE_VIP_ID=
STRIPE_PRICE_VIP_PLUS_ID=
STRIPE_PRICE_HERO_ID=
STRIPE_PRICE_EMPEROR_ID=
STRIPE_PRICE_IMPERATOR_ID=

# Liaison Minecraft <-> site
MINECRAFT_LINK_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET_32_BYTES_RECOMMENDED
MINECRAFT_SURVIVAL_WORLD=world

# Calagopus
CALAGOPUS_PANEL_URL=https://panel.omesky-heberg.com
CALAGOPUS_STATUS_API_KEY=
CALAGOPUS_ADMIN_API_KEY=
CALAGOPUS_PROXY_ID=
CALAGOPUS_WARZONE_ID=
CALAGOPUS_SPAWN_ID=
CALAGOPUS_MINIGAME_ID=
CALAGOPUS_AUTH_ID=

# Compat anciens grades (facultatif)
STRIPE_PRICE_COPPER_ID=
STRIPE_PRICE_IRON_ID=
STRIPE_PRICE_GOLD_ID=
STRIPE_PRICE_DIAMOND_ID=
STRIPE_PRICE_NETHERITE_ID=
DISCORD_ROLE_COPPER_ID=
DISCORD_ROLE_IRON_ID=
DISCORD_ROLE_GOLD_ID=
DISCORD_ROLE_DIAMOND_ID=
DISCORD_ROLE_NETHERITE_ID=
